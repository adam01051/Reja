<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title><%= user.name %> Portfolio</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<link rel="stylesheet" href="/main.css" />
	</head>
	<body class="portfolio-page">
		<div class="portfolio-shell">
			<nav class="app-nav portfolio-nav motion-rise" aria-label="Primary navigation">
				<a class="brand-mark" href="/author">
					<span>A</span>
					<strong><%= user.name %></strong>
				</a>
				<div class="portfolio-nav__links">
					<a class="nav-link" href="/">Planner</a>
					<a class="nav-link" href="#services">Services</a>
					<a class="nav-link" href="#skills">Skills</a>
				</div>
			</nav>

			<main class="portfolio-layout">
				<aside class="profile-panel motion-rise">
					<div class="profile-card">
						<img src="/author/images/profile.svg" alt="<%= user.name %> profile" />
						<h1><%= user.name %></h1>
						<p><%= user.profession %></p>
						<div class="profile-socials" aria-label="Social links">
							<a href="#" aria-label="LinkedIn"><img src="/author/icon/vec1.svg" alt="" /></a>
							<a href="#" aria-label="Instagram"><img src="/author/icon/vec2.svg" alt="" /></a>
							<a href="#" aria-label="Twitter"><img src="/author/icon/vec3.svg" alt="" /></a>
							<a href="#" aria-label="GitHub"><img src="/author/icon/vec4.svg" alt="" /></a>
						</div>
					</div>

					<section class="profile-facts" aria-label="Profile facts">
						<div><span>Age</span><strong><%= user.age %></strong></div>
						<div><span>Residence</span><strong><%= user.residence %></strong></div>
						<div><span>Freelance</span><strong class="success">Available</strong></div>
						<div><span>Address</span><strong><%= user.address %></strong></div>
					</section>
				</aside>

				<section class="portfolio-content">
					<header class="portfolio-hero motion-rise">
						<div class="portfolio-hero__copy">
							<p class="eyebrow">Software engineer</p>
							<h2><%= user.work_place %></h2>
							<p><%= user.about_me %></p>
							<a class="primary-button" href="#contact">Hire me</a>
						</div>
						<div class="portfolio-hero__media">
							<img src="/author/icon/img1.png" alt="Developer illustration" />
							<span class="orb one"></span>
							<span class="orb two"></span>
							<span class="orb three"></span>
						</div>
					</header>

					<section id="services" class="section-block motion-section">
						<div class="section-heading">
							<p class="eyebrow">Capabilities</p>
							<h2>My services</h2>
							<p><%= user.service_desc %></p>
						</div>
						<div class="service-grid">
							<article class="service-card motion-card">
								<img src="/author/box_images/coding.svg" alt="" />
								<h3>Web Development</h3>
								<p>Blogs, e-commerce, APIs, and polished user interfaces.</p>
							</article>
							<article class="service-card motion-card">
								<img src="/author/box_images/illustration.svg" alt="" />
								<h3>UI/UX Design</h3>
								<p>Mobile app and website flows with clean visual systems.</p>
							</article>
							<article class="service-card motion-card">
								<img src="/author/box_images/mic.svg" alt="" />
								<h3>Sound Design</h3>
								<p>Voice-over, audio editing, and creative production support.</p>
							</article>
							<article class="service-card motion-card">
								<img src="/author/box_images/game.svg" alt="" />
								<h3>Game Design</h3>
								<p>Interactive ideas, simple game mechanics, and prototypes.</p>
							</article>
							<article class="service-card motion-card">
								<img src="/author/box_images/phot1.svg" alt="" />
								<h3>Photography</h3>
								<p>Portrait, product, and story-led visual direction.</p>
							</article>
							<article class="service-card service-card--cta motion-card">
								<h3>Advertising</h3>
								<p>Campaign concepts and landing page content for launches.</p>
								<a href="#contact">Order now</a>
							</article>
						</div>
					</section>
				</section>

				<aside id="skills" class="skills-panel motion-rise">
					<section class="skill-group">
						<h2>Languages</h2>
						<% user.languages.map(function(language, index){ const values = [100, 80, 60]; %>
						<div class="skill-row">
							<div><span><%= language %></span><strong><%= values[index] %>%</strong></div>
							<span class="skill-bar"><em style="width: <%= values[index] %>%"></em></span>
						</div>
						<% }) %>
					</section>

					<section class="skill-group">
						<h2>Skills</h2>
						<% user.skills.map(function(skill, index){ const values = [90, 85, 80, 75, 85]; %>
						<div class="skill-row">
							<div><span><%= skill %></span><strong><%= values[index] %>%</strong></div>
							<span class="skill-bar"><em style="width: <%= values[index] %>%"></em></span>
						</div>
						<% }) %>
					</section>

					<section class="skill-group">
						<h2>Extra skills</h2>
						<ul class="extra-list">
							<% user.extra_skills.map(function(skill){ %>
							<li><%= skill %></li>
							<% }) %>
						</ul>
					</section>

					<section id="contact" class="contact-card">
						<p class="eyebrow">Contact</p>
						<h2>Ready for a clean build?</h2>
						<a class="primary-button" href="/">Open planner</a>
					</section>
				</aside>
			</main>
		</div>

		<script type="module" src="/browser.js"></script>
	</body>
</html>
