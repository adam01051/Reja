<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Reja Planner</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<link rel="stylesheet" href="/main.css" />
	</head>
	<body class="reja-page">
		<main class="task-shell">
			<header class="task-hero motion-rise">
				<nav class="app-nav" aria-label="Primary navigation">
					<a class="brand-mark" href="/">
						<span>R</span>
						<strong>Reja</strong>
					</a>
					<a class="nav-link" href="/author">Portfolio</a>
				</nav>

				<section class="task-hero__content">
					<div>
						<p class="eyebrow">Daily planning dashboard</p>
						<h1>Plan clearly. Finish calmly.</h1>
						<p>
							Keep goals in one focused workspace with quick create, edit, and
							clean-up actions.
						</p>
					</div>
					<div class="task-hero__stats" aria-label="Task summary">
						<span><%= items.length %></span>
						<strong><%= items.length === 1 ? "active plan" : "active plans" %></strong>
					</div>
				</section>
			</header>

			<section class="task-board motion-rise" aria-labelledby="task-board-title">
				<div class="task-board__header">
					<div>
						<p class="eyebrow">Workspace</p>
						<h2 id="task-board-title">Today&apos;s plans</h2>
					</div>
					<button
						id="clean-all"
						class="ghost-button danger"
						type="button"
						<%= items.length === 0 ? "disabled" : "" %>
					>
						Clear all
					</button>
				</div>

				<form id="create-form" class="task-form" action="/create-item" method="POST">
					<label for="create-field">New plan</label>
					<div class="task-form__row">
						<input
							id="create-field"
							name="reja"
							autofocus
							autocomplete="off"
							type="text"
							placeholder="Write a goal, habit, or reminder"
							maxlength="140"
						/>
						<button class="primary-button" type="submit">Add plan</button>
					</div>
					<p id="form-feedback" class="form-feedback" aria-live="polite"></p>
				</form>

				<ul
					id="item-list"
					class="task-list <%= items.length === 0 ? "is-empty" : "" %>"
					aria-live="polite"
				>
					<% items.map(function(item, index){ %>
					<li class="task-card motion-item" style="--delay: <%= index * 55 %>ms">
						<span class="task-card__index"><%= String(index + 1).padStart(2, "0") %></span>
						<span class="item-text"><%= item.reja %></span>
						<div class="task-card__actions">
							<button
								data-id="<%= item._id %>"
								class="edit-me icon-button"
								type="button"
								aria-label="Edit plan"
							>
								Edit
							</button>
							<button
								data-id="<%= item._id %>"
								class="delete-me icon-button danger"
								type="button"
								aria-label="Delete plan"
							>
								Delete
							</button>
						</div>
					</li>
					<% }) %>
				</ul>

				<div id="empty-state" class="empty-state <%= items.length === 0 ? "" : "hidden" %>">
					<span></span>
					<strong>No plans yet</strong>
					<p>Add your first plan above and it will appear here.</p>
				</div>
			</section>
		</main>

		<script type="module" src="/browser.js"></script>
	</body>
</html>
